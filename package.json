{
  "name": "proyecto-catalogo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",

    "build:staging": "ng build --configuration=staging",
    "build:production": "ng build --configuration=production",
    
    "deploy:staging": "firebase use staging && npm run build:staging && firebase deploy --only hosting",
    "deploy:production": "firebase use production && npm run build:production && firebase deploy --only hosting"
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "dependencies": {
